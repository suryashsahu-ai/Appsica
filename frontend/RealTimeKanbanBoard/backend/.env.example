# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB URI)
# Requires a running MongoDB instance or replica set (e.g. mongodb://localhost:27017/kanban_db)
MONGODB_URI=mongodb://localhost:27017/kanban_board

# JWT Security
# Ensure this is a cryptographically strong, random string in production
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=15m

# Admin Credentials (strictly loaded from environment)
# These credentials grant access to the Admin audit/system endpoints
ADMIN_ID=admin_kanban
ADMIN_PASSWORD=ChangeThisSecureAdminPassword123!
